# Static frontend image (client, livreur, partenaires, admin).
# Build context: repo root (pnpm workspace).
#   docker build -f deploy/Dockerfile.front --build-arg APP=client \
#     --build-arg VITE_API_URL=https://api.rapiliv.com/api .
# Used by deploy/docker-compose.yml.
ARG APP=client
FROM node:22-bookworm-slim AS build
ARG APP
ARG VITE_API_URL
RUN corepack enable
WORKDIR /app

# Manifests first, so dependency install is cached across code changes.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/client/package.json apps/client/
COPY apps/livreur/package.json apps/livreur/
COPY apps/partenaires/package.json apps/partenaires/
COPY apps/admin/package.json apps/admin/
COPY packages/config/package.json packages/config/
RUN pnpm install --frozen-lockfile --filter @delivero/${APP}...

# Sources needed for the build (Vite + tsc project references @delivero/config).
COPY apps/${APP} apps/${APP}
COPY packages/config packages/config
WORKDIR /app/apps/${APP}
ENV VITE_API_URL=${VITE_API_URL}
RUN pnpm build

FROM nginx:1-alpine
ARG APP
COPY deploy/nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/${APP}/dist /usr/share/nginx/html
EXPOSE 80
