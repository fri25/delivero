# Copier en deploy/.env sur le serveur et remplir. Ne jamais committer deploy/.env.
# Toutes les variables ci-dessous sont transmises à l'API ; voir
# apps/api/.env.example pour le détail de chacune.

# --- Infrastructure ---------------------------------------------------------------
# Nom de domaine de l'API, pointé (enregistrement A) vers l'IP publique de la VM.
# Sans nom de domaine : api.<IP-avec-des-tirets>.sslip.io (ex. api.129-151-10-20.sslip.io).
API_DOMAIN="api.chapexpress.bj"
# Mot de passe PostgreSQL : chaîne aléatoire, ex. `openssl rand -hex 24`.
POSTGRES_PASSWORD=""

# --- API ------------------------------------------------------------------------------
# Un proxy (Caddy) devant l'API : nécessaire pour que la limite par IP voie la vraie IP.
TRUST_PROXY="1"
# `openssl rand -hex 32`
JWT_SECRET=""
JWT_EXPIRES_IN="2h"
# URLs exactes des 4 apps sur Cloudflare Pages, séparées par des virgules.
CORS_ORIGINS="https://client.chapexpress.bj,https://livreur.chapexpress.bj,https://partenaires.chapexpress.bj,https://admin.chapexpress.bj"
CLIENT_APP_URL="https://client.chapexpress.bj"

SERVICES_ACTIFS="repas,colis,courses_express"
MODES_PAIEMENT_ACTIFS="mobile_money"
CONTRE_REMBOURSEMENT_ACTIF=false

# FedaPay — webhook à déclarer : https://<API_DOMAIN>/api/paiements/webhook/fedapay
FEDAPAY_ENVIRONMENT="sandbox"
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""

# Web Push — `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@chapexpress.bj"

# WhatsApp/SMS — "console" tant que les identifiants Twilio ne sont pas renseignés
MESSAGERIE_FOURNISSEUR="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

COURRIEL_FOURNISSEUR="console"
RESEND_API_KEY=""

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
