# ==============================================================================
# ChapExpress — variables de PRODUCTION (serveur VPS, Traefik externe)
#   cd deploy && cp .env.example .env   # puis remplir les valeurs marquées ✏️
# Ne JAMAIS committer deploy/.env (couvert par .gitignore).
# Référence des règles de validation : apps/api/src/config/env.validation.ts
# ==============================================================================

# --- Infrastructure ---------------------------------------------------------------
# Nom de domaine de l'API, pointé (enregistrement A) vers l'IP publique du VPS. ✏️
API_DOMAIN="api.rapiliv.com"
# Domaines des 4 fronts, même DNS. ✏️
CLIENT_DOMAIN="client.rapiliv.com"
LIVREUR_DOMAIN="livreur.rapiliv.com"
PARTENAIRES_DOMAIN="partenaires.rapiliv.com"
ADMIN_DOMAIN="admin.rapiliv.com"
# URL API figée au build des 4 fronts (rebuild si changée). ✏️
VITE_API_URL="https://api.rapiliv.com/api"
# Le réseau Docker partagé avec le Traefik déjà présent sur le serveur
# (`docker network ls` doit l'afficher, sinon `docker network create proxy`).
# Mot de passe PostgreSQL : hex uniquement, ex. `openssl rand -hex 24`. ✏️
# Obligatoire : un mot de passe avec @ / : ? # & casserait la DATABASE_URL
# ci-dessous s'il n'est pas encodé. Ne garder que des caractères [0-9a-f].
POSTGRES_PASSWORD=""
# URL complète vers la base du compose (hôte interne `db`). ✏️
# Reconstruire à chaque changement de POSTGRES_PASSWORD :
# postgresql://delivero:<POSTGRES_PASSWORD>@db:5432/delivero?schema=public
DATABASE_URL=""

# --- API ----------------------------------------------------------------------------
# Géré par docker-compose.yml : NODE_ENV=production, PORT=3000 (ne pas redéfinir ici).
# Un proxy (Traefik + Cloudflare) devant l'API : nécessaire pour que la limite
# par IP voie la vraie IP. 2 hops = Cloudflare + Traefik.
TRUST_PROXY="2"
# 32 octets min. requis par l'API : `openssl rand -hex 32` (64 caractères hex). ✏️
# Générer un NEUF pour la prod — ne jamais recopier celui du dev.
JWT_SECRET=""
# Prod : "24h" (choisi le 07/11/2026). Jeton non révocable : ne pas allonger davantage.
JWT_EXPIRES_IN="24h"
# URLs exactes des apps en production, séparées par des virgules, sans `/` final. ✏️
CORS_ORIGINS="https://client.rapiliv.com,https://livreur.rapiliv.com,https://partenaires.rapiliv.com,https://admin.rapiliv.com"
CLIENT_APP_URL="https://client.rapiliv.com"

SERVICES_ACTIFS="repas,colis,courses_express"
MODES_PAIEMENT_ACTIFS="mobile_money"
CONTRE_REMBOURSEMENT_ACTIF="false"

# --- FedaPay (Mobile Money) -------------------------------------------------------------
# Webhook à déclarer : https://<API_DOMAIN>/api/paiements/webhook/fedapay
# Rester en `sandbox` tant que le paiement n'est pas validé de bout en bout,
# passer à `live` + clés live ensuite. ✏️
FEDAPAY_ENVIRONMENT="sandbox"
FEDAPAY_SECRET_KEY=""
FEDAPAY_WEBHOOK_SECRET=""
# NB : FEDAPAY_API_KEY (clé publique) n'est pas lue par l'API — inutile ici.

# --- Web Push ------------------------------------------------------------------------------
# `npx web-push generate-vapid-keys`, UNE SEULE paire pour la prod. ✏️
# Ne plus les changer ensuite (abonnements existants invalidés).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@rapiliv.com"

# --- WhatsApp / SMS -------------------------------------------------------------------
# "console" tant que les identifiants Twilio ne sont pas renseignés
# (en prod : passer à "twilio" + remplir les 3 variables requises). ✏️
MESSAGERIE_FOURNISSEUR="console"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Expéditeur SMS : numéro Twilio (+…) ou Messaging Service SID (MG…).
TWILIO_SMS_FROM=""
# Expéditeur WhatsApp (+…) : essayé en premier, SMS en repli. Optionnel.
TWILIO_WHATSAPP_FROM=""

# --- E-mail ---------------------------------------------------------------------------------
# "console" = logs API uniquement ; "resend" exige RESEND_API_KEY. ✏️
COURRIEL_FOURNISSEUR="console"
RESEND_API_KEY=""
COURRIEL_EXPEDITEUR="ChapExpress <notifications@rapiliv.com>"

# --- Photos (Cloudinary) ----------------------------------------------------------------
# Tableau de bord Cloudinary > Settings > API Keys. Vides = champs photo masqués.
# CLOUD_NAME et API_KEY (identifiants publics) déjà renseignés.
CLOUDINARY_CLOUD_NAME="deliveroo"
CLOUDINARY_API_KEY="686722167731373"
# Secret : régénéré après exposition — Dashboard > Regenerate, puis coller ici. ✏️
CLOUDINARY_API_SECRET=""
