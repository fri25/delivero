{
  "name": "delivero",
  "private": true,
  "version": "0.0.0",
  "description": "ChapExpress — plateforme de livraison multi-services (Natitingou, Bénin)",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev:client": "pnpm --filter @delivero/client dev",
    "dev:livreur": "pnpm --filter @delivero/livreur dev",
    "dev:partenaires": "pnpm --filter @delivero/partenaires dev",
    "dev:admin": "pnpm --filter @delivero/admin dev",
    "dev:api": "pnpm --filter @delivero/api start:dev",
    "build": "pnpm -r --filter \"./apps/**\" build",
    "lint": "pnpm -r --filter \"./apps/**\" lint",
    "typecheck": "pnpm -r --filter \"./apps/**\" typecheck"
  }
}
