{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@nestjs/mapped-types$": "<rootDir>/mapped-types.mock.ts"
  },
  "setupFiles": ["<rootDir>/setup-e2e.ts"],
  "testTimeout": 30000
}
