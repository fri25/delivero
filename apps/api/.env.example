NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://delivero:delivero@localhost:5432/delivero?schema=public"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176"
# --- Périmètre V1 ------------------------------------------------------------
# Chaque variable a son pendant dans packages/config/perimetre-v1.ts, qui masque
# les points d'entrée côté interfaces. Les deux se basculent ensemble.
#
# Services ouverts à la création de commande. Emplettes est développé mais hors
# périmètre V1 : l'ajouter ici ET passer EMPLETTES_ACTIF à true pour le rouvrir.
SERVICES_ACTIFS="repas,colis,courses_express"
# Moyens de paiement acceptés. V1 : Mobile Money uniquement (via FedaPay),
# espèces retirées (écart assumé avec RG-01).
MODES_PAIEMENT_ACTIFS="mobile_money"
# --- FedaPay (Mobile Money) -----------------------------------------------------
# Clés du tableau de bord FedaPay (Paramètres > Clés API). Laisser vides désactive
# le paiement. Ne jamais committer de vraies clés.
FEDAPAY_ENVIRONMENT="sandbox"
FEDAPAY_SECRET_KEY=""
# Secret de l'endpoint webhook (Paramètres > Webhooks), URL à déclarer côté FedaPay :
# https://<api>/api/paiements/webhook/fedapay
FEDAPAY_WEBHOOK_SECRET=""
# URL de l'app client, où FedaPay renvoie le client après paiement.
CLIENT_APP_URL="http://localhost:5173"
# --- Notifications ----------------------------------------------------------------
# Web Push : clés générées une fois avec `npx web-push generate-vapid-keys`.
# Vides = push désactivé, toutes les alertes passent par WhatsApp/SMS.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@chapexpress.bj"
# Fournisseur WhatsApp/SMS (repli de toutes les alertes + codes OTP). Seul
# "console" existe pour l'instant : les messages sont écrits dans les logs de l'API.
MESSAGERIE_FOURNISSEUR="console"
# --- Photos (Cloudinary) ----------------------------------------------------------
# Tableau de bord Cloudinary > Settings > API Keys. Vides = champs photo masqués.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Contre-remboursement Colis (RG-04) : encaissement espèces auprès du
# destinataire, retiré de la V1 avec les espèces.
CONTRE_REMBOURSEMENT_ACTIF=false
JWT_SECRET="change-me-to-a-random-string-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"
