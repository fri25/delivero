// --- Paiement --------------------------------------------------------------
// Enregistrement du mode/statut choisi à la commande (RG-01, F-CLI-04) ;
// aucune intégration FedaPay réelle à ce stade (Q-07 décide le prestataire,
// pas l'intégration).

enum ModePaiement {
  mobile_money
  especes
}

enum StatutPaiement {
  en_attente
  reussi
  echoue
  a_percevoir_livraison
  // Mobile Money collected, then the order was refused or cancelled: refunded
  // by hand from the back-office (decision of 2026-10-05), which then moves
  // the payment to `rembourse`.
  a_rembourser
  rembourse
}

model Paiement {
  id                   String         @id @default(cuid())
  commandeId           String         @unique @map("commande_id")
  commande             Commande       @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  montant              Decimal        @db.Decimal(12, 2)
  mode                 ModePaiement
  statut               StatutPaiement @default(en_attente)
  // Current FedaPay transaction id for this payment (replaced when the client
  // retries a failed payment): the webhook matches on it.
  referenceTransaction String?        @unique @map("reference_transaction")
  createdAt            DateTime       @default(now()) @map("created_at")

  // Manual refund (decision of 2026-10-13): the amount may be lower than
  // `montant` (e.g. delivery fee kept), the reason is then required.
  montantRembourse       Decimal?  @map("montant_rembourse") @db.Decimal(12, 2)
  referenceRemboursement String?   @map("reference_remboursement")
  motifRemboursement     String?   @map("motif_remboursement")
  rembourseAt            DateTime? @map("rembourse_at")
  rembourseParId         String?   @map("rembourse_par_id")
  remboursePar           User?     @relation("PaiementRembourseePar", fields: [rembourseParId], references: [id])

  // Manual entry (F-ADM-04, decision of 2026-10-13): the client sends Mobile
  // Money straight to the ChapExpress number and the dispatcher confirms
  // receipt with the operator's reference — no FedaPay transaction.
  referenceManuelle String?   @map("reference_manuelle")
  confirmeAt        DateTime? @map("confirme_at")
  confirmeParId     String?   @map("confirme_par_id")
  confirmePar       User?     @relation("PaiementConfirmePar", fields: [confirmeParId], references: [id])

  // Company (étapes 2 and 4 of docs/plan-migration-multi-tenant.md). Set by
  // the Prisma extension; a write that escapes it fails instead of landing
  // in some company: the default reads app.tenant_id, unset outside RLS.
  tenantId String @default(dbgenerated("current_setting('app.tenant_id'::text)")) @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@map("paiements")
}

